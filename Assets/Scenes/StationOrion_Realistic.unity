      m_Calls: []
  m_text: '<b><color=#7FE8FF>HOW TO PLAY</color></b>

    <size=75%><align=left><b>TELEPORT</b> 
    aim at the floor and release

    <b>GRAB</b>  point at an object, hold GRIP

    <b>DROP
    / PLACE</b>  let go of GRIP over the slot

    <b>PRESS BUTTONS</b>  point +
    GRIP


    Follow the floating <color=#7FE8FF>cyan diamond</color>.

    The
    screens show your objective and the reactor timer.</align></size>'
